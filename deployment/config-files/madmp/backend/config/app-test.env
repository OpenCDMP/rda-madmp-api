###
### Authentication
###
IDP_ISSUER_URI=http://host.docker.internal:8081/auth/realms/madmp
IDP_CLAIMS_ROLES_PATH=api.roles
SECURITY_AUDIENCE=api
CORS_ALLOWED_ORIGIN=http://host.docker.internal:8081

###
### DB
###
DB_CONNECTION_STRING=jdbc:postgresql://madmp.postgres:5432/madmp
DB_USER=postgres
DB_PASSWORD=postgres-admin

###
### Elastic
###
ELASTIC_USE_SSL=false
ELASTIC_HOST=madmp.elasticsearch:9200
ELASTIC_USER=madmp-api-user
ELASTIC_PASS=madmp-api-pass
ELASTIC_RDA_INDEX=madmp-test

###
### MADMP
###
### uncomment if you want to fetch only dmps that come from external apps
### RDA_MADMP_APPLY_INTEGRATION_ACTION=true

###
### Queue
###
QUEUE_APP_ID=madmp-api-test
OPENCDMP_QUEUE_APP_ID=opencdmp-api-test
QUEUE_NAME=madmp_api_inbox_queue
QUEUE_EXCHANGE=madmp_queue
RABBIT_HOST=madmp.rabbitmq
RABBIT_PORT=5672
RABBIT_USER=guest
RABBIT_PASS=guest

###
### Keycloak API
###
KEYCLOAK_API_SERVER_URL=http://host.docker.internal:8081/auth
KEYCLOAK_API_REALM=madmp
KEYCLOAK_API_CLIENT_ID=api
KEYCLOAK_API_CLIENT_SECRET=web_secret
KEYCLOAK_API_USERNAME=dmp-keycloak-api
KEYCLOAK_API_PASSWORD=admin

###
### Logging
###
### LOGGING_CONFIG_PATH =
### LOGGING_DEFAULT_LOG_LEVEL=
### LOGGING_PATH=

###
### Swagger
###
SWAGGER_SERVER_URL=http://host.docker.internal:8081
SWAGGER_AUTH_REDIRECT_URL=http://host.docker.internal:8081/swagger-ui/oauth2-redirect.html
SWAGGER_AUTH_CLIENT_ID=swagger
WEB_CONTEXT_PATH=
